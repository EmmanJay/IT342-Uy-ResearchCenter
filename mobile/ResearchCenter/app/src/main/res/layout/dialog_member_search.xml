<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:backgroundTint="@color/surface_white"
    android:padding="@dimen/space_6">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Search Member"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:textColor="@color/text_primary"
        android:layout_marginBottom="@dimen/space_4" />

    <com.google.android.material.textfield.TextInputEditText
        android:id="@+id/etMemberSearch"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:paddingHorizontal="12dp"
        android:background="@drawable/bg_dialog_rounded"
        android:hint="Search by email..."
        android:textSize="@dimen/text_sm"
        android:inputType="textEmailAddress"
        android:drawableStart="@android:drawable/ic_menu_search"
        android:drawablePadding="@dimen/space_2" />

    <ListView
        android:id="@+id/lvSearchResults"
        android:layout_width="match_parent"
        android:layout_height="250dp"
        android:divider="@null"
        android:dividerHeight="0dp"
        android:visibility="visible"
        android:layout_marginTop="@dimen/space_4" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/space_4">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnMemberInviteCancel"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textColor="@color/text_secondary" />
    </LinearLayout>

</LinearLayout>
