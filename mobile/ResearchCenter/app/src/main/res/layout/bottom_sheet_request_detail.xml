<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="@dimen/space_6">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="@dimen/space_4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tv_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Request Title"
                android:textSize="@dimen/text_xl"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tv_subtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Requested by Unknown"
                android:textSize="@dimen/text_xs"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_status_badge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="OPEN"
            android:textSize="@dimen/text_xs"
            android:textStyle="bold"
            android:textColor="@color/primary_green"
            android:background="@drawable/badge_bg"
            android:paddingHorizontal="@dimen/space_2"
            android:paddingVertical="4dp"
            android:layout_marginStart="@dimen/space_3" />
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_1" />

            <TextView
                android:id="@+id/tv_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No description provided."
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/space_4" />

            <!-- Closure Note Box (only visible when fulfilled/closed) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dialog_rounded"
                android:backgroundTint="@color/background_gray"
                android:padding="@dimen/space_3"
                android:layout_marginBottom="@dimen/space_6">
                
                <TextView
                    android:id="@+id/tv_closure_note"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Fulfilled by Admin: Material has been uploaded to the repository."
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_primary"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_color"
                android:layout_marginBottom="@dimen/space_6" />

            <!-- Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_close_request"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Close Request"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_secondary"
                    app:strokeColor="@color/border_color"
                    app:cornerRadius="@dimen/radius_md"
                    android:layout_marginEnd="@dimen/space_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fulfill_request"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Fulfill Request"
                    android:textSize="@dimen/text_sm"
                    app:backgroundTint="@color/primary_green"
                    app:cornerRadius="@dimen/radius_md" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
