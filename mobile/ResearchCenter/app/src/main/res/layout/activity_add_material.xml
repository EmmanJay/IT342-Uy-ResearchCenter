<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/background_gray">

    <!-- Navbar / App Bar -->
    <com.google.android.material.appbar.AppBarLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:elevation="1dp"
        android:background="@color/surface_white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_6"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:src="@drawable/logo"
                android:layout_marginEnd="@dimen/space_2" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="ResearchCenter"
                android:textColor="@color/primary_green"
                android:textSize="20sp"
                android:textStyle="bold" />
                
            <com.example.researchcenter.shared.ui.UserAvatarView
                android:id="@+id/tv_avatar"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:visibility="gone" />
        </LinearLayout>
        
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/border_color" />
    </com.google.android.material.appbar.AppBarLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/space_6"
            android:layout_gravity="center_horizontal"
           > <!-- max-w-2xl -->

            <com.example.researchcenter.shared.ui.BreadcrumbsView
                android:id="@+id/breadcrumbs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_marginBottom="@dimen/space_4" />

            <TextView
                android:id="@+id/tv_form_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Add Material"
                android:visibility="visible"
                android:textSize="30sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_6" />

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface_white"
                android:layout_marginBottom="@dimen/space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_6">

                    <!-- Google Books Search Container -->
                    <LinearLayout
                        android:id="@+id/container_google_search"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="@dimen/space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Search Google Books (Optional)"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="@dimen/space_2" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/et_search_books"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:paddingTop="8dp"
                                android:paddingBottom="8dp"
                                android:paddingHorizontal="12dp"
                                android:background="@drawable/bg_dialog_rounded"
                                android:hint="Search by title, author, or ISBN"
                                android:textSize="@dimen/text_sm"
                                android:inputType="text" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_search_books"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/space_2"
                                android:text="Search"
                                android:textSize="@dimen/text_sm"
                                app:cornerRadius="@dimen/radius_md"
                                app:backgroundTint="@color/primary_green" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tv_metadata_loaded"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Metadata loaded from Google Books"
                            android:textColor="@color/primary_green"
                            android:textSize="@dimen/text_xs"
                            android:layout_marginTop="@dimen/space_2"
                            android:visibility="gone" />
                        
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/border_color"
                            android:layout_marginTop="@dimen/space_4" />
                    </LinearLayout>

                    <!-- Title -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Title *"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_1" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/bg_dialog_rounded"
                        android:layout_marginBottom="@dimen/space_4"
                        android:textSize="@dimen/text_sm" />

                    <!-- Description -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_1" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_description"
                        android:layout_width="match_parent"
                        android:layout_height="96dp"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/bg_dialog_rounded"
                        android:layout_marginBottom="@dimen/space_4"
                        android:gravity="top|start"
                        android:textSize="@dimen/text_sm" />

                    <!-- Material Type -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Material Type *"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_1" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_4"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/border_color"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                        <AutoCompleteTextView
                            android:id="@+id/act_material_type"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:text="Link"
                            android:textSize="@dimen/text_sm" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Dynamic Containers -->
                    <!-- 1. URL Container -->
                    <LinearLayout
                        android:id="@+id/container_url"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:layout_marginBottom="@dimen/space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="URL *"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="@dimen/space_1" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_url"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:inputType="textUri"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- 2. ISBN Container -->
                    <LinearLayout
                        android:id="@+id/container_isbn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="ISBN"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="@dimen/space_1" />

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_isbn"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingTop="8dp"
                            android:paddingBottom="8dp"
                            android:paddingHorizontal="12dp"
                            android:background="@drawable/bg_dialog_rounded"
                            android:hint="Optional ISBN"
                            android:inputType="text"
                            android:textSize="@dimen/text_sm" />
                    </LinearLayout>

                    <!-- 3. Upload PDF Container -->
                    <LinearLayout
                        android:id="@+id/container_pdf"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/space_4">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Upload PDF"
                            android:textSize="@dimen/text_sm"
                            android:textStyle="bold"
                            android:textColor="@color/text_primary"
                            android:layout_marginBottom="@dimen/space_1" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btn_upload_pdf"
                                style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Choose File"
                                android:textSize="@dimen/text_sm"
                                android:textColor="@color/text_primary"
                                app:strokeColor="@color/border_color"
                                app:cornerRadius="@dimen/radius_md" />

                            <TextView
                                android:id="@+id/tv_file_name"
                                android:layout_width="0dp"
                                android:layout_weight="1"
                                android:layout_height="wrap_content"
                                android:text="No file selected"
                                android:textColor="@color/text_secondary"
                                android:textSize="@dimen/text_sm"
                                android:layout_marginStart="@dimen/space_3" />

                            <ImageButton
                                android:id="@+id/btn_remove_file"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:src="@android:drawable/ic_menu_close_clear_cancel"
                                android:background="?attr/selectableItemBackgroundBorderless"
                                app:tint="@color/status_cancelled"
                                android:visibility="gone" />
                        </LinearLayout>
                    </LinearLayout>

                    <!-- Tags -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tags (comma-separated)"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_1" />

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_tags"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingTop="8dp"
                        android:paddingBottom="8dp"
                        android:paddingHorizontal="12dp"
                        android:background="@drawable/bg_dialog_rounded"
                        android:layout_marginBottom="@dimen/space_6"
                        android:textSize="@dimen/text_sm" />

                    <!-- Action Buttons -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="end">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_cancel"
                            style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Cancel"
                            android:textSize="@dimen/text_sm"
                            android:textColor="@color/text_primary"
                            app:strokeColor="@color/border_color"
                            app:cornerRadius="@dimen/radius_md"
                            android:layout_marginEnd="@dimen/space_3" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btn_save"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Add Material"
                            android:textSize="@dimen/text_sm"
                            app:backgroundTint="@color/primary_green"
                            app:cornerRadius="@dimen/radius_md" />
                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>
</LinearLayout>
