<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_dialog_rounded"
    android:backgroundTint="@color/surface_white"
    android:padding="@dimen/space_6">

    <TextView
        android:id="@+id/tvDialogRepoName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_lg"
        android:textStyle="bold"
        android:textColor="@color/text_primary" />

    <TextView
        android:id="@+id/tvDialogRepoMeta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_xs"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/space_1" />

    <TextView
        android:id="@+id/tvDialogRepoDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_sm"
        android:textColor="@color/text_secondary"
        android:layout_marginTop="@dimen/space_3" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="end"
        android:layout_marginTop="@dimen/space_6">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogClose"
            style="@style/Widget.MaterialComponents.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Close"
            android:textColor="@color/text_secondary"
            android:layout_marginEnd="@dimen/space_2" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDialogView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="View Repository"
            app:cornerRadius="@dimen/radius_md"
            app:backgroundTint="@color/primary_green" />
    </LinearLayout>

</LinearLayout>
