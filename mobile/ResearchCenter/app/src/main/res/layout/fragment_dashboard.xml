<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe_refresh"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Welcome Section -->
            <TextView
                android:id="@+id/tv_welcome"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Welcome back!"
                android:textSize="24sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/dashboard_subtitle"
                android:textSize="14sp"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="4dp" />

            <!-- Create Button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_create_repo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/create_new_repo"
                android:textSize="14sp"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                app:backgroundTint="@color/primary_green"
                app:cornerRadius="6dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="10dp"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="16dp"
                xmlns:app="http://schemas.android.com/apk/res-auto" />

            <!-- Error Banner -->
            <LinearLayout
                android:id="@+id/layout_error_banner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:background="@color/red_50"
                android:padding="12dp"
                android:visibility="gone"
                android:gravity="center_vertical">
                <TextView
                    android:id="@+id/tv_error_banner"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textColor="@color/error_red"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Your Repositories Header -->
            <TextView
                android:id="@+id/tv_my_repos_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Research Repositories (0)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- My Repos List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_my_repositories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Joined Repos Header -->
            <TextView
                android:id="@+id/tv_joined_repos_header"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Invited Repositories (0)"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/gray_900"
                android:layout_marginTop="16dp"
                android:layout_marginBottom="8dp"
                android:visibility="gone" />

            <!-- Joined Repos List -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rv_joined_repositories"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                android:visibility="gone" />

            <!-- Empty State -->
            <LinearLayout
                android:id="@+id/layout_empty_state"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp"
                android:background="@drawable/rounded_card"
                android:visibility="gone">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_repositories"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/gray_900" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/no_repos_subtitle"
                    android:textSize="14sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="4dp"
                    android:gravity="center" />
            </LinearLayout>



        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
