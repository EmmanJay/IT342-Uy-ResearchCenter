<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout 
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray">

    <!-- AppBar Layout with Back Button -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface_white"
        app:elevation="1dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/space_4">

            <ImageButton
                android:id="@+id/btn_back"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/text_primary"
                android:contentDescription="Go Back"
                android:rotation="180" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Material Details"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginStart="@dimen/space_2" />
        </LinearLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Scrollable content -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior"
        android:padding="@dimen/space_4">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Title & Info Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface_white"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <TextView
                        android:id="@+id/tvMatTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Material Title"
                        android:textSize="22sp"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="4dp" />

                    <TextView
                        android:id="@+id/tvMatMeta"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Uploaded by Unknown"
                        android:textSize="@dimen/text_sm"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="@dimen/space_4" />

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/border_color"
                        android:layout_marginBottom="@dimen/space_4" />

                    <!-- Meta details row -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Type:"
                            android:textStyle="bold"
                            android:textSize="@dimen/text_sm"
                            android:textColor="@color/text_primary" />

                        <TextView
                            android:id="@+id/tvMatType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" PDF"
                            android:textSize="@dimen/text_sm"
                            android:textColor="@color/text_secondary"
                            android:layout_marginStart="4dp" />

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1" />

                        <TextView
                            android:id="@+id/tvMatStatusChip"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="TO READ"
                            android:textSize="@dimen/text_xs"
                            android:textStyle="bold"
                            android:textColor="@color/warning_amber"
                            android:background="@drawable/badge_bg"
                            android:paddingHorizontal="@dimen/space_3"
                            android:paddingVertical="4dp" />
                    </LinearLayout>

                    <!-- Dropdown for personal status update -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Update Status:"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_xs"
                        android:textColor="@color/text_secondary"
                        android:layout_marginTop="@dimen/space_4"
                        android:layout_marginBottom="4dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/space_3"
                        app:boxBackgroundMode="outline"
                        app:boxStrokeColor="@color/border_color"
                        app:hintEnabled="false"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu">

                        <AutoCompleteTextView
                            android:id="@+id/actMatPersonalStatus"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="none"
                            android:text="To Read"
                            android:textSize="@dimen/text_sm" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Document action button -->
                    <Button
                        android:id="@+id/btnMatOpenLink"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="View Document"
                        android:textSize="@dimen/text_sm"
                        app:cornerRadius="@dimen/radius_md"
                        android:textColor="@color/primary_green"
                        app:backgroundTint="@color/green_50"
                        android:visibility="gone"
                        android:layout_marginTop="@dimen/space_2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Book / Reference Details Card (visible only for REFERENCE) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardReferenceDetails"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface_white"
                android:layout_marginBottom="@dimen/space_4"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Reference Details"
                        android:textSize="@dimen/text_base"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_3" />

                    <TextView
                        android:id="@+id/tvMatAuthors"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_sm"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvMatPublisher"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_sm"
                        android:textColor="@color/text_secondary"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/tvMatYearIsbn"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textSize="@dimen/text_sm"
                        android:textColor="@color/text_secondary"
                        android:drawablePadding="4dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Description Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface_white"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Description"
                        android:textSize="@dimen/text_base"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_2" />

                    <TextView
                        android:id="@+id/tvMatDesc"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="No description provided."
                        android:textSize="@dimen/text_sm"
                        android:textColor="@color/text_secondary"
                        android:lineSpacingMultiplier="1.2" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Tags Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface_white"
                android:layout_marginBottom="@dimen/space_4">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tags"
                        android:textSize="@dimen/text_base"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_3" />

                    <HorizontalScrollView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:scrollbars="none">
                        
                        <LinearLayout
                            android:id="@+id/llMatTags"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal" />
                    </HorizontalScrollView>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Private Note Card -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="2dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface_white"
                android:layout_marginBottom="@dimen/space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_5">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="My Private Note"
                        android:textSize="@dimen/text_base"
                        android:textStyle="bold"
                        android:textColor="@color/text_primary"
                        android:layout_marginBottom="@dimen/space_2" />

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.ResearchCenter.TextInputLayout"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="@dimen/space_3"
                            app:boxBackgroundMode="outline"
                            app:boxStrokeColor="@color/primary_green"
                            app:hintEnabled="false">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etMatNote"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:minLines="3"
                                android:gravity="top|start"
                                android:hint="Add a private note about this material..."
                                android:background="@android:color/transparent"
                                android:textSize="@dimen/text_sm" />
                        </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnMatSaveNote"
                        style="@style/Widget.MaterialComponents.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save Note"
                        android:textColor="@color/primary_green"
                        android:textSize="@dimen/text_sm"
                        android:layout_gravity="end" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="48dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMatBookmark"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:text="Bookmark"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_color"
                    app:cornerRadius="@dimen/radius_md"
                    android:layout_marginEnd="@dimen/space_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMatDelete"
                    android:layout_width="0dp"
                    android:layout_weight="1"
                    android:layout_height="52dp"
                    android:text="Delete"
                    android:textSize="@dimen/text_sm"
                    app:backgroundTint="@color/error_red"
                    app:cornerRadius="@dimen/radius_md"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
