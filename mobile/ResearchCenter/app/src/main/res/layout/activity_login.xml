<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_gray"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Header -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/surface_white"
            android:paddingTop="@dimen/space_4"
            android:paddingBottom="@dimen/space_4"
            android:elevation="1dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:src="@drawable/logo"
                    android:layout_marginEnd="@dimen/space_3" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ResearchCenter"
                    android:textColor="@color/primary_green"
                    android:textSize="@dimen/text_xl"
                    android:textStyle="bold" />
            </LinearLayout>
            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_gravity="bottom"
                android:background="@color/divider" />
        </FrameLayout>

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:paddingTop="64dp"
            android:paddingBottom="64dp"
            android:paddingStart="@dimen/space_4"
            android:paddingEnd="@dimen/space_4">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="@dimen/radius_lg"
                app:cardElevation="4dp"
                app:strokeWidth="1dp"
                app:strokeColor="@color/border_color"
                app:cardBackgroundColor="@color/surface_white"
               >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/space_8">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sign In"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_2xl"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Enter your credentials to access your account"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm"
                        android:layout_marginTop="@dimen/space_1"
                        android:layout_marginBottom="@dimen/space_6" />

                    <!-- Email Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email Address"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/space_1" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_email"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:boxCornerRadiusTopStart="@dimen/radius_md"
                        app:boxCornerRadiusTopEnd="@dimen/radius_md"
                        app:boxCornerRadiusBottomStart="@dimen/radius_md"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_md"
                        android:layout_marginBottom="@dimen/space_4">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_email"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="you@example.com"
                            android:inputType="textEmailAddress"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textSize="@dimen/text_sm" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- Password Field -->
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password"
                        android:textColor="@color/text_primary"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:layout_marginBottom="@dimen/space_1" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_password"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        app:hintEnabled="false"
                        app:passwordToggleEnabled="true"
                        app:boxCornerRadiusTopStart="@dimen/radius_md"
                        app:boxCornerRadiusTopEnd="@dimen/radius_md"
                        app:boxCornerRadiusBottomStart="@dimen/radius_md"
                        app:boxCornerRadiusBottomEnd="@dimen/radius_md">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_password"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="••••••••"
                            android:inputType="textPassword"
                            android:paddingTop="12dp"
                            android:paddingBottom="12dp"
                            android:textSize="@dimen/text_sm" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Forgot Password?"
                        android:textColor="@color/primary_green"
                        android:textSize="@dimen/text_sm"
                        android:gravity="end"
                        android:layout_marginTop="@dimen/space_2"
                        android:layout_marginBottom="@dimen/space_4" />

                    <!-- Error Text (Hidden by default) -->
                    <TextView
                        android:id="@+id/tv_error"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textColor="@color/error_red"
                        android:textSize="@dimen/text_sm"
                        android:textStyle="bold"
                        android:visibility="gone"
                        android:layout_marginBottom="@dimen/space_4" />

                    <!-- Submit Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_login"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:text="Sign In"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_sm"
                        app:cornerRadius="@dimen/radius_md"
                        app:backgroundTint="@color/primary_green" />

                    <!-- Divider -->
                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:layout_marginBottom="@dimen/space_4">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:layout_centerVertical="true"
                            android:background="@color/divider" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:background="@color/surface_white"
                            android:paddingStart="@dimen/space_2"
                            android:paddingEnd="@dimen/space_2"
                            android:text="or"
                            android:textColor="@color/text_secondary"
                            android:textSize="@dimen/text_sm" />
                    </RelativeLayout>

                    <!-- Google Sign In -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_google_sign_in"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Sign in with Google"
                        android:textColor="@color/text_primary"
                        app:cornerRadius="@dimen/radius_md"
                        app:strokeColor="@color/border_color" />

                    <!-- Sign Up Link -->
                    <TextView
                        android:id="@+id/tv_go_register"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/space_4"
                        android:gravity="center"
                        android:text="Don't have an account? Sign Up"
                        android:textColor="@color/text_secondary"
                        android:textSize="@dimen/text_sm" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </LinearLayout>
</ScrollView>
