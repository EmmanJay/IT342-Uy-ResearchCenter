<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bottom_sheet_bg"
    android:padding="@dimen/space_6">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="top"
        android:layout_marginBottom="@dimen/space_4">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvMatTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Material Title"
                android:textSize="@dimen/text_2xl"
                android:textStyle="bold"
                android:textColor="@color/text_primary" />

            <TextView
                android:id="@+id/tvMatMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Uploaded by Unknown"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:layout_marginTop="@dimen/space_1" />
        </LinearLayout>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Meta & Status Bar (Gray 50 box) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_dialog_rounded"
                android:backgroundTint="@color/background_gray"
                android:padding="@dimen/space_3"
                android:layout_marginBottom="@dimen/space_6">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/space_3">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Type:"
                        android:textStyle="bold"
                        android:textSize="@dimen/text_sm"
                        android:textColor="@color/text_primary" />

                    <TextView
                        android:id="@+id/tvMatType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" PDF"
                        android:textSize="@dimen/text_sm"
                        android:textColor="@color/text_secondary"
                        android:layout_marginStart="4dp" />
                        
                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/tvMatStatusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="TO READ"
                        android:textSize="@dimen/text_xs"
                        android:textStyle="bold"
                        android:textColor="@color/warning_amber"
                        android:background="@drawable/badge_bg"
                        android:paddingHorizontal="@dimen/space_3"
                        android:paddingVertical="4dp" />
                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/space_3"
                    app:boxBackgroundMode="none"
                    style="@style/Widget.MaterialComponents.TextInputLayout.FilledBox.ExposedDropdownMenu">

                    <AutoCompleteTextView
                        android:id="@+id/actMatPersonalStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:padding="12dp"
                        android:background="@drawable/rounded_card"
                        android:inputType="none"
                        android:text="To Read"
                        android:textSize="@dimen/text_sm" />
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Actions / Links -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <Button
                        android:id="@+id/btnMatOpenLink"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="View PDF"
                        android:textSize="@dimen/text_sm"
                        app:cornerRadius="@dimen/radius_md"
                        android:textColor="@color/primary_green"
                        app:backgroundTint="@color/green_50"
                        android:visibility="gone" />
                </LinearLayout>
            </LinearLayout>

            <!-- Book metadata -->
            <TextView
                android:id="@+id/tvMatAuthors"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMatPublisher"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="4dp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvMatYearIsbn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/space_4"
                android:visibility="gone" />

            <!-- Description -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_2" />

            <TextView
                android:id="@+id/tvMatDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="No description provided."
                android:textSize="@dimen/text_sm"
                android:textColor="@color/text_secondary"
                android:layout_marginBottom="@dimen/space_6" />

            <!-- Tags -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tags"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_2" />

            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:layout_marginBottom="@dimen/space_6">
                
                <LinearLayout
                    android:id="@+id/llMatTags"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Private Note Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="My Private Note"
                android:textSize="@dimen/text_sm"
                android:textStyle="bold"
                android:textColor="@color/text_primary"
                android:layout_marginBottom="@dimen/space_2" />

            <com.google.android.material.textfield.TextInputLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/space_3"
                app:boxBackgroundMode="outline"
                app:boxStrokeColor="@color/primary_green"
                app:hintEnabled="false">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etMatNote"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minLines="3"
                    android:gravity="top|start"
                    android:hint="Add a private note about this material..."
                    android:textSize="@dimen/text_sm" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnMatSaveNote"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Save Note"
                android:textColor="@color/primary_green"
                android:textSize="@dimen/text_sm"
                android:layout_gravity="end"
                android:layout_marginBottom="@dimen/space_4" />

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="@color/border_color"
                android:layout_marginBottom="@dimen/space_6" />

            <!-- Bottom Actions -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="end">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMatBookmark"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Bookmark"
                    android:textSize="@dimen/text_sm"
                    android:textColor="@color/text_primary"
                    app:strokeColor="@color/border_color"
                    app:cornerRadius="@dimen/radius_md"
                    android:layout_marginEnd="@dimen/space_2" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnMatDelete"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Delete"
                    android:textSize="@dimen/text_sm"
                    app:backgroundTint="@color/error_red"
                    app:cornerRadius="@dimen/radius_md"
                    android:visibility="gone" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
